# ==========================================
# macOS Code Signing & Apple Notarization
# ==========================================
# (Required ONLY if you have an Apple Developer Account and want
# to distribute macOS builds without any Gatekeeper / 'unidentified developer' warnings)

# 1. Your Apple ID email associated with the Developer Account:
APPLE_ID=your-apple-id@example.com

# 2. An App-Specific Password generated at https://appleid.apple.com -> Sign-In and Security -> App-Specific Passwords:
APPLE_APP_SPECIFIC_PASSWORD=xxxx-xxxx-xxxx-xxxx

# 3. Your 10-character Apple Developer Team ID (found at developer.apple.com/account -> Membership Details):
APPLE_TEAM_ID=XXXXXXXXXX

# Optional: If you build in CI/CD (GitHub Actions) without Keychain:
# Base64 encoded .p12 certificate file and password:
# CSC_LINK=
# CSC_KEY_PASSWORD=

# ==========================================
# Windows Authenticode Code Signing
# ==========================================
# (Required ONLY if you have a Windows Code Signing / EV Certificate or Azure Trusted Signing
# to prevent Microsoft Defender SmartScreen "Windows protected your PC / Unknown Publisher" warnings)

# Path to .pfx certificate file or base64 string:
# WIN_CSC_LINK=./certs/windows-codesign.pfx
# Password for the .pfx certificate:
# WIN_CSC_KEY_PASSWORD=YourCertPassword123

