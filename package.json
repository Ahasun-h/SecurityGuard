{
  "name": "security-guard",
  "version": "1.0.0",
  "description": "Security Guard Desktop - Supply-chain, Malware & Host Threat Defense Center with GitHub Auth & AI Analysis",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "npm run build:mac && npm run build:win && npm run build:linux",
    "build:all": "npm run build:mac && npm run build:win && npm run build:linux",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "fix:mac": "bash fix-mac.sh"
  },
  "keywords": [
    "security",
    "malware-scanner",
    "supply-chain",
    "github",
    "electron"
  ],
  "author": {
    "name": "Ahasun Habib",
    "email": "habibahasun019@gmail.com",
    "url": "https://github.com/Ahasun-h"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0"
  },
  "productName": "Security Guard",
  "build": {
    "appId": "com.securityguard.defensehub",
    "productName": "Security Guard",
    "afterPack": "build/afterPack.js",
    "afterSign": "build/notarize.js",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**/*",
      "renderer/**/*",
      "package.json",
      "guard.sh"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "${productName} Setup ${version}.${ext}",
      "runAfterFinish": true
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Security",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "maintainer": "Security Guard Team <support@securityguard.local>",
      "syncDesktopName": true
    }
  },
  "desktopName": "security-guard"
}